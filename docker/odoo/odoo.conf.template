# =============================================================================
# EchangoCrm — template de configuration Odoo
# =============================================================================
# Rendu au démarrage par entrypoint-echangocrm.sh vers ODOO_RC
# (/etc/odoo/odoo.conf), avec les valeurs de .env.production, via
# string.Template (Python).
#
# ⚠️ AUCUN SIGNE DOLLAR DANS LES COMMENTAIRES. string.Template ne connaît pas
# la notion de commentaire : il balaie le fichier entier. Un nom de variable
# cité en prose est donc réellement substitué, et une écriture qui n'est pas
# un identifiant valide (une élision, un exemple entre accolades) fait échouer
# le rendu — donc refuse le démarrage du conteneur — pour une ligne qui ne
# devait rien produire. Cas rencontré à l'écriture de ce fichier. Pour parler
# d'une variable dans un commentaire, écrire son nom nu, sans dollar.
#
# ⚠️ FORMAT DES LIGNES `db_*` : garder EXACTEMENT « clé = valeur », un espace
# de chaque côté du =. L'entrypoint de l'image Odoo amont relit ces quatre
# valeurs avec `cut -d " " -f3` pour reconstruire ses arguments --db_* ; toute
# autre mise en forme lui fait lire une valeur tronquée ou vide.
# =============================================================================

[options]

# --- Mot de passe maître ----------------------------------------------------
# Autorise création / duplication / suppression de base via /web/database/*.
# Avec list_db = False ces pages sont désactivées, mais on renseigne quand
# même un vrai secret : deux verrous valent mieux qu'un pour un geste
# destructeur, et list_db peut être rouvert temporairement lors d'une
# restauration.
admin_passwd = ${ODOO_ADMIN_PASSWD}

# --- Base de données --------------------------------------------------------
# `postgres_crm`, PAS `postgres` : le réseau echango_network est partagé avec
# la stack Vendure, qui a son propre service nommé `postgres`. Un conteneur
# attaché aux deux réseaux résout le nom générique vers LEUR conteneur —
# incident réel constaté sur le déploiement echango Promo, le symptôme étant
# un « password authentication failed » avec un mot de passe pourtant exact.
# Voir docs/DEPLOIEMENT_VPS.md.
db_host = postgres_crm
db_port = 5432
db_user = odoo
db_password = ${POSTGRES_PASSWORD}

# Une seule base, nommée explicitement, et un filtre qui n'en laisse voir
# aucune autre. list_db = False ferme le gestionnaire de bases web.
db_name = ${ODOO_DB_NAME}
dbfilter = ^${ODOO_DB_NAME}$$
list_db = False

# 4 processus (2 workers + cron + gevent) x 16 connexions = 64, sous les 100
# de max_connections par défaut de Postgres. Le défaut Odoo (64 par processus)
# saturerait la base bien avant d'être utile.
db_maxconn = 16

# --- Réseau -----------------------------------------------------------------
http_interface = 0.0.0.0
http_port = 8069

# Port gevent : websocket (chat, notifications temps réel, activités CRM).
# ⚠️ Il n'est servi QUE si workers > 0 — en mode threadé (workers = 0) Odoo
# répond au websocket sur 8069 et rien n'écoute sur 8072. Le routeur Traefik
# dédié à /websocket pointe sur 8072 : garder ODOO_WORKERS >= 2.
gevent_port = 8072

# Derrière Traefik : sans ceci Odoo construit ses URLs absolues en http:// et
# journalise l'IP du proxy au lieu de celle du client.
proxy_mode = True

# --- Processus --------------------------------------------------------------
workers = ${ODOO_WORKERS}
max_cron_threads = ${ODOO_MAX_CRON_THREADS}

# Limites délibérément basses : le VPS héberge plusieurs applications. Ce sont
# des seuils de recyclage, pas des réservations — un worker qui dépasse
# limit_memory_soft termine sa requête puis redémarre proprement. Les monter
# si les rapports PDF volumineux ou les imports se font tuer.
limit_memory_soft = 671088640
limit_memory_hard = 838860800
limit_time_cpu = 600
limit_time_real = 1200
limit_time_real_cron = 1800
limit_request = 8192

# --- Données et modules -----------------------------------------------------
# /var/lib/odoo = filestore (pièces jointes, images produits, sessions).
# ⚠️ Il est AUSSI vital que la base : une sauvegarde SQL seule restaure un
# CRM dont toutes les pièces jointes sont cassées.
data_dir = /var/lib/odoo

# Même valeur que l'odoo.conf livré par l'image amont : les addons du cœur
# sont trouvés via le paquet Python installé, pas via ce chemin.
addons_path = /mnt/extra-addons

# Aucune donnée de démonstration en production.
without_demo = all

# --- Journalisation ---------------------------------------------------------
# Pas de logfile : sortie standard, récupérée par `docker compose logs`.
log_level = ${ODOO_LOG_LEVEL}
