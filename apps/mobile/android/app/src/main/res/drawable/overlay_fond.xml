<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Bleu ardoise du design system, opaque : la surimpression se pose sur
         l'écran d'appel du système, dont on ne maîtrise ni le fond ni le
         thème. Une transparence rendrait le texte illisible sur certains
         constructeurs. -->
    <solid android:color="#12293D" />
    <corners android:radius="16dp" />
    <stroke android:width="1dp" android:color="#2A4A66" />
</shape>
