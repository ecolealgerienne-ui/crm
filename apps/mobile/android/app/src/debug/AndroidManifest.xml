<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!--
        Trafic en clair autorisé en DÉBOGAGE UNIQUEMENT.

        L'instance Odoo de développement tourne en http sur le poste
        (http://10.0.2.2:8169 vu depuis l'émulateur), sans certificat. Le
        manifeste de `main` interdit le clair, et c'est ce qui doit valoir en
        production : le jeton de l'appareil part dans un en-tête
        `Authorization`, et l'accepter en http en ferait un secret lisible par
        n'importe quel réseau wifi traversé.

        Cette surcharge ne s'applique qu'à la variante de débogage — un APK de
        production ne peut pas parler en clair, quelle que soit l'adresse
        saisie dans les réglages.
    -->
    <application android:usesCleartextTraffic="true" tools:replace="android:usesCleartextTraffic">
        <!--
            Provisionnement en ligne de commande pour le banc d'essai.
            Déclaré ici et implémenté dans src/debug/ : ni le receveur ni sa
            déclaration n'existent dans un APK de release. Voir
            DevProvisionReceiver.kt.
        -->
        <receiver
            android:name=".DevProvisionReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.echango.call_tracker.DEV_PROVISION" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
