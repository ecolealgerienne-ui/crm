<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_crm_lead_form_call_tracker" model="ir.ui.view">
        <field name="name">crm.lead.form.call.tracker</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_voir_appels" type="object"
                        class="oe_stat_button" icon="fa-phone"
                        invisible="call_tracker_count == 0">
                    <field name="call_tracker_count" widget="statinfo" string="Appels"/>
                </button>
            </div>
        </field>
    </record>

</odoo>
