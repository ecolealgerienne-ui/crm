<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <menuitem id="menu_call_tracker_root"
              name="Call Tracker"
              parent="crm.crm_menu_root"
              sequence="45"/>

    <menuitem id="menu_call_tracker_log"
              name="Appels"
              parent="menu_call_tracker_root"
              action="action_call_tracker_log"
              sequence="10"/>

    <menuitem id="menu_call_tracker_a_qualifier"
              name="Appels à qualifier"
              parent="menu_call_tracker_root"
              action="action_call_tracker_a_qualifier"
              sequence="12"/>

    <menuitem id="menu_call_tracker_coverage"
              name="Couverture du portefeuille"
              parent="menu_call_tracker_root"
              action="action_call_tracker_coverage"
              sequence="18"/>

    <menuitem id="menu_call_tracker_lead_activity"
              name="Relance des affaires"
              parent="menu_call_tracker_root"
              action="action_call_tracker_lead_activity"
              sequence="19"/>

    <!-- Ouvert à tous les utilisateurs internes : chacun doit pouvoir voir sa
         propre activité, l'action s'ouvrant groupée par commercial. -->
    <menuitem id="menu_call_tracker_dashboard"
              name="Activité téléphonique"
              parent="menu_call_tracker_root"
              action="action_call_tracker_dashboard"
              sequence="15"/>

    <!-- Administrateurs en écriture — c'est d'ici que se génèrent et se
         révoquent les jetons — et responsables EN LECTURE.
         Le responsable est celui qui compare les commerciaux entre eux ;
         lui fermer cet écran l'oblige à le faire sans pouvoir distinguer
         « Farid n'a passé aucun appel » de « le téléphone de Farid n'envoie
         plus rien depuis lundi », qui produisent exactement le même tableau.
         Le jeton n'apparaît nulle part dans ces vues : il n'est affiché
         qu'une fois, par l'assistant, réservé aux administrateurs. -->
    <menuitem id="menu_call_tracker_device"
              name="Appareils"
              parent="menu_call_tracker_root"
              action="action_call_tracker_device"
              groups="base.group_system,group_call_tracker_manager"
              sequence="20"/>

    <menuitem id="menu_call_tracker_audit"
              name="Journal d'audit"
              parent="menu_call_tracker_root"
              action="action_call_tracker_audit"
              groups="base.group_system"
              sequence="30"/>

</odoo>
