<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_call_tracker_log_list" model="ir.ui.view">
        <field name="name">call.tracker.log.list</field>
        <field name="model">call.tracker.log</field>
        <field name="arch" type="xml">
            <list string="Appels" create="false">
                <field name="started_at"/>
                <field name="user_id"/>
                <field name="phone_number"/>
                <field name="direction"/>
                <field name="duration_seconds" sum="Durée totale"/>
                <field name="partner_id"/>
                <field name="lead_id"/>
                <field name="device_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_call_tracker_log_form" model="ir.ui.view">
        <field name="name">call.tracker.log.form</field>
        <field name="model">call.tracker.log</field>
        <field name="arch" type="xml">
            <form string="Appel" create="false">
                <sheet>
                    <group>
                        <group string="Appel">
                            <field name="phone_number"/>
                            <field name="direction"/>
                            <field name="duration_seconds"/>
                            <field name="started_at"/>
                        </group>
                        <group string="Origine">
                            <field name="user_id"/>
                            <field name="device_id"/>
                            <field name="client_event_id"/>
                        </group>
                    </group>
                    <group string="Rattachement">
                        <field name="partner_id"/>
                        <field name="lead_id"/>
                        <field name="phone_key" groups="base.group_no_one"/>
                    </group>
                    <group string="Note" invisible="not note">
                        <field name="note" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_call_tracker_log_search" model="ir.ui.view">
        <field name="name">call.tracker.log.search</field>
        <field name="model">call.tracker.log</field>
        <field name="arch" type="xml">
            <search string="Appels">
                <field name="phone_number"/>
                <field name="user_id"/>
                <field name="partner_id"/>
                <filter name="entrant" string="Entrants" domain="[('direction','=','inbound')]"/>
                <filter name="sortant" string="Sortants" domain="[('direction','=','outbound')]"/>
                <filter name="manque" string="Manqués" domain="[('direction','=','missed')]"/>
                <separator/>
                <filter name="sans_contact" string="Sans contact rattaché"
                        domain="[('partner_id','=',False)]"/>
                <separator/>
                <!-- Filtres de regroupement à plat, sans <group> englobant :
                     depuis Odoo 17 le RelaxNG des vues recherche réserve
                     <group> au regroupement de CHAMPS et rejette l'attribut
                     `expand`. Un <group expand="0" string="Regrouper par">
                     fait échouer l'installation du module, pas seulement
                     l'affichage. -->
                <filter name="par_commercial" string="Commercial" context="{'group_by': 'user_id'}"/>
                <filter name="par_direction" string="Direction" context="{'group_by': 'direction'}"/>
                <filter name="par_jour" string="Jour" context="{'group_by': 'started_at:day'}"/>
            </search>
        </field>
    </record>

    <record id="action_call_tracker_log" model="ir.actions.act_window">
        <field name="name">Appels</field>
        <field name="res_model">call.tracker.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_call_tracker_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun appel journalisé</p>
            <p>
                Les appels remontent automatiquement depuis l'application
                mobile des commerciaux. Ils ne se créent pas à la main.
            </p>
        </field>
    </record>

</odoo>
