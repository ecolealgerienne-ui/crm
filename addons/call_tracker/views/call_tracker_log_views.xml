<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_call_tracker_log_list" model="ir.ui.view">
        <field name="name">call.tracker.log.list</field>
        <field name="model">call.tracker.log</field>
        <field name="arch" type="xml">
            <list string="Appels" create="false">
                <field name="started_at"/>
                <field name="user_id"/>
                <field name="phone_number"/>
                <field name="direction"/>
                <field name="duration_seconds" sum="Durée totale"/>
                <field name="outcome" optional="show"/>
                <field name="delivery_lag_minutes" optional="hide"/>
                <field name="hour_of_day" optional="hide"/>
                <field name="partner_id"/>
                <field name="lead_id"/>
                <field name="device_id" optional="hide"/>
                <!-- Qualifier depuis la liste, sans ouvrir chaque appel : la
                     file « Appels à qualifier » se traite en série, et deux
                     clics par ligne la rendraient pénible donc désertée. -->
                <button name="action_creer_piste" type="object"
                        icon="fa-plus-circle" title="Créer une piste"
                        invisible="lead_id or partner_id"/>
            </list>
        </field>
    </record>

    <record id="view_call_tracker_log_form" model="ir.ui.view">
        <field name="name">call.tracker.log.form</field>
        <field name="model">call.tracker.log</field>
        <field name="arch" type="xml">
            <form string="Appel" create="false">
                <header>
                    <button name="action_creer_piste" type="object"
                            string="Créer une piste" class="btn-primary"
                            invisible="lead_id or partner_id"/>
                    <!-- Les deux actions d'enrichissement, visibles seulement
                         une fois l'appel rattaché : sans client ni piste, la
                         note n'aurait nulle part où aller. -->
                    <button name="action_completer_note" type="object"
                            string="Compléter la note" class="btn-primary"
                            invisible="not lead_id and not partner_id"/>
                    <button name="action_ouvrir_client" type="object"
                            string="Ouvrir la fiche client"
                            invisible="not lead_id and not partner_id"/>
                </header>
                <sheet>
                    <group>
                        <group string="Appel">
                            <field name="phone_number"/>
                            <field name="direction"/>
                            <field name="outcome"/>
                            <field name="duration_seconds"/>
                            <field name="started_at"/>
                        </group>
                        <group string="Origine">
                            <field name="user_id"/>
                            <field name="device_id"/>
                            <field name="client_event_id"/>
                            <field name="delivery_lag_minutes"/>
                        </group>
                    </group>
                    <group string="Rattachement">
                        <field name="partner_id"/>
                        <field name="lead_id"/>
                        <field name="phone_key" groups="base.group_no_one"/>
                    </group>
                    <group string="Note prise pendant l'appel" invisible="not note">
                        <field name="note" nolabel="1" readonly="1"/>
                    </group>
                    <!-- ⚠️ L'appel est en LECTURE SEULE, et ce n'est pas un
                         oubli : ses faits — durée, horodatage, sens — sont le
                         socle du reporting, et une durée corrigeable rendrait
                         chaque chiffre négociable. Ce qui s'ajoute après coup
                         va au fil du client, qui est cumulatif par nature —
                         et qui repart vers le téléphone. -->
                    <group string="Ce que le téléphone affichera au prochain appel">
                        <field name="last_note" nolabel="1" readonly="1"
                               placeholder="Aucune note sur ce client pour l'instant."/>
                        <div colspan="2" class="text-muted"
                             invisible="not lead_id and not partner_id">
                            Pour ajouter ou corriger, utilisez
                            <b>Compléter la note</b> : le texte est publié dans le fil
                            du client, jamais sur l'appel — un appel est un compte rendu,
                            il ne se réécrit pas.
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_call_tracker_log_search" model="ir.ui.view">
        <field name="name">call.tracker.log.search</field>
        <field name="model">call.tracker.log</field>
        <field name="arch" type="xml">
            <search string="Appels">
                <field name="phone_number"/>
                <field name="user_id"/>
                <field name="partner_id"/>
                <filter name="entrant" string="Entrants" domain="[('direction','=','inbound')]"/>
                <filter name="sortant" string="Sortants" domain="[('direction','=','outbound')]"/>
                <filter name="manque" string="Manqués" domain="[('direction','=','missed')]"/>
                <separator/>
                <filter name="repondu" string="Répondus" domain="[('outcome','=','answered')]"/>
                <filter name="sans_reponse" string="Sans réponse"
                        domain="[('outcome','=','no_answer')]"/>
                <separator/>
                <filter name="sans_contact" string="Sans contact rattaché"
                        domain="[('partner_id','=',False)]"/>
                <filter name="a_qualifier" string="À qualifier"
                        domain="[('partner_id','=',False),('lead_id','=',False)]"/>
                <separator/>
                <filter name="mes_appels" string="Mes appels"
                        domain="[('user_id','=',uid)]"/>
                <filter name="aujourdhui" string="Aujourd'hui"
                        domain="[('started_at','&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <filter name="semaine" string="7 derniers jours"
                        domain="[('started_at','&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter name="avec_note" string="Avec note"
                        domain="[('note','!=',False)]"/>
                <separator/>
                <!-- Le filtre à regarder AVANT tout classement entre
                     commerciaux : un téléphone qui remonte avec des heures de
                     retard fausse tout chiffre journalier. Voir
                     docs/REPORTING_KPI.md. -->
                <filter name="remise_tardive" string="Remise tardive (&gt; 1 h)"
                        domain="[('delivery_lag_minutes','&gt;',60)]"/>
                <separator/>
                <!-- Filtres de regroupement à plat, sans <group> englobant :
                     depuis Odoo 17 le RelaxNG des vues recherche réserve
                     <group> au regroupement de CHAMPS et rejette l'attribut
                     `expand`. Un <group expand="0" string="Regrouper par">
                     fait échouer l'installation du module, pas seulement
                     l'affichage. -->
                <filter name="par_commercial" string="Commercial" context="{'group_by': 'user_id'}"/>
                <filter name="par_direction" string="Direction" context="{'group_by': 'direction'}"/>
                <filter name="par_jour" string="Jour" context="{'group_by': 'started_at:day'}"/>
                <filter name="par_issue" string="Issue" context="{'group_by': 'outcome'}"/>
                <filter name="par_heure" string="Heure de la journée"
                        context="{'group_by': 'hour_of_day'}"/>
                <filter name="par_appareil" string="Appareil"
                        context="{'group_by': 'device_id'}"/>
            </search>
        </field>
    </record>

    <!--
        Tableau de bord — deux vues d'agrégation sur le MÊME modèle, plutôt
        qu'un écran dédié.

        La spec (§4.2) envisageait un tableau de bord dans l'application, en
        WebView au besoin. Le faire ici coûte deux vues et donne mieux : les
        filtres, les regroupements et l'export d'Odoo, plus la possibilité pour
        chacun d'enregistrer SA vue. Un écran natif aurait figé une seule
        lecture des données.
    -->
    <record id="view_call_tracker_log_graph" model="ir.ui.view">
        <field name="name">call.tracker.log.graph</field>
        <field name="model">call.tracker.log</field>
        <field name="arch" type="xml">
            <graph string="Appels" type="bar" sample="1">
                <field name="started_at" interval="day"/>
                <field name="user_id"/>
                <!-- La durée en mesure, et non le simple décompte : dix appels
                     de cinq secondes ne valent pas dix conversations. -->
                <field name="duration_seconds" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_call_tracker_log_pivot" model="ir.ui.view">
        <field name="name">call.tracker.log.pivot</field>
        <field name="model">call.tracker.log</field>
        <field name="arch" type="xml">
            <pivot string="Appels" sample="1">
                <field name="user_id" type="row"/>
                <field name="outcome" type="col"/>
                <field name="duration_seconds" type="measure"/>
                <!-- Le délai de remise en mesure : c'est ici qu'un téléphone
                     qui décroche du reste se voit, sans avoir à le chercher. -->
                <field name="delivery_lag_minutes" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_call_tracker_dashboard" model="ir.actions.act_window">
        <field name="name">Activité téléphonique</field>
        <field name="res_model">call.tracker.log</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="search_view_id" ref="view_call_tracker_log_search"/>
        <!-- Ouvre sur les sept derniers jours : « tous les appels depuis
             toujours » n'est une question que personne ne se pose. -->
        <field name="context">{'search_default_semaine': 1, 'search_default_par_commercial': 1}</field>
    </record>

    <!--
        La file de travail des appels sans correspondance.
        
        C'est la contrepartie du retrait de la création automatique de pistes :
        un prospect entrant ne peut pas avoir été créé à l'avance, et ne rien
        créer le perdrait — sauf si quelqu'un regarde cette file. Elle est donc
        un MENU, pas un filtre qu'il faut penser à cocher.
    -->
    <record id="action_call_tracker_a_qualifier" model="ir.actions.act_window">
        <field name="name">Appels à qualifier</field>
        <field name="res_model">call.tracker.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_call_tracker_log_search"/>
        <field name="domain">[('partner_id','=',False),('lead_id','=',False)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Rien à qualifier</p>
            <p>
                Les appels dont le numéro ne correspond à aucun contact ni à
                aucune piste arrivent ici. Le bouton « Créer une piste » en
                crée une, attribuée au commercial qui a passé ou reçu l'appel,
                et rattache d'un coup tous les appels du même numéro.
            </p>
        </field>
    </record>

    <record id="action_call_tracker_log" model="ir.actions.act_window">
        <field name="name">Appels</field>
        <field name="res_model">call.tracker.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_call_tracker_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun appel journalisé</p>
            <p>
                Les appels remontent automatiquement depuis l'application
                mobile des commerciaux. Ils ne se créent pas à la main.
            </p>
        </field>
    </record>

</odoo>
