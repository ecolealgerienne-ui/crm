<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_call_tracker_device_list" model="ir.ui.view">
        <field name="name">call.tracker.device.list</field>
        <field name="model">call.tracker.device</field>
        <field name="arch" type="xml">
            <list string="Appareils"
                  decoration-warning="silencieux"
                  decoration-muted="not active">
                <field name="name"/>
                <field name="user_id"/>
                <field name="log_count" string="Appels"/>
                <field name="device_model"/>
                <field name="os_version"/>
                <field name="last_seen"/>
                <field name="silencieux" column_invisible="True"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_call_tracker_device_form" model="ir.ui.view">
        <field name="name">call.tracker.device.form</field>
        <field name="model">call.tracker.device</field>
        <field name="arch" type="xml">
            <form string="Appareil">
                <header>
                    <!-- Le responsable a cet écran en lecture seule : lui
                         montrer un bouton qui échouera sur un refus de droits
                         serait pire que ne pas le montrer. -->
                    <button name="action_generer_jeton" type="object"
                            string="Générer un jeton" class="btn-primary"
                            groups="base.group_system"
                            invisible="not id"
                            confirm="Générer un nouveau jeton révoque immédiatement le précédent : l'appareil ne pourra plus remonter d'appel tant que le nouveau jeton n'y est pas saisi. Continuer ?"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Révoqué" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="name" placeholder="Samsung d'Amar"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <!-- Declares par l'appareil lui-meme a chaque
                                 envoi : servent a expliquer un delai de
                                 remise, pas a etablir un fait. -->
                            <field name="device_model"/>
                            <field name="os_version"/>
                            <field name="last_seen"/>
                            <field name="log_count"/>
                        </group>
                    </group>
                    <div class="text-muted" invisible="id">
                        Enregistrez l'appareil, puis générez son jeton. Le jeton
                        n'est affiché qu'une seule fois.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Sans vue recherche, un appareil révoqué (donc archivé) disparaissait
         de la liste sans aucun moyen de le retrouver ni de le rétablir. -->
    <record id="view_call_tracker_device_search" model="ir.ui.view">
        <field name="name">call.tracker.device.search</field>
        <field name="model">call.tracker.device</field>
        <field name="arch" type="xml">
            <search string="Appareils">
                <field name="name"/>
                <field name="user_id"/>
                <field name="device_model"/>
                <!-- Seuil aligné sur SILENCE_JOURS du modèle : il ne peut pas
                     s'exprimer via le champ calculé, qui n'est pas stocké et
                     ne se cherche donc pas. Les deux sont à changer ensemble. -->
                <filter name="silencieux" string="Silencieux depuis 3 jours"
                        domain="['|',
                                 ('last_seen', '=', False),
                                 ('last_seen', '&lt;', (datetime.datetime.now() - datetime.timedelta(days=3)).strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <filter name="jamais_vu" string="N'a jamais rien envoyé"
                        domain="[('last_seen', '=', False)]"/>
                <separator/>
                <filter name="inactif" string="Révoqués"
                        domain="[('active', '=', False)]"/>
                <separator/>
                <!-- Filtres de regroupement à plat : voir le commentaire de la
                     vue recherche des appels. Le RelaxNG d'Odoo 19 rejette
                     `<group expand="0">` dans une vue recherche, et l'échec
                     est à l'INSTALLATION du module, pas à l'affichage. -->
                <filter name="par_commercial" string="Commercial"
                        context="{'group_by': 'user_id'}"/>
                <filter name="par_modele" string="Modèle d'appareil"
                        context="{'group_by': 'device_model'}"/>
            </search>
        </field>
    </record>

    <record id="action_call_tracker_device" model="ir.actions.act_window">
        <field name="name">Appareils</field>
        <field name="res_model">call.tracker.device</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Déclarer un appareil</p>
            <p>
                Un appareil correspond à un commercial. Son jeton, généré ici,
                est le seul identifiant que l'application mobile transmet — il
                ne porte aucun droit Odoo et se révoque sans toucher au compte
                du commercial.
            </p>
        </field>
    </record>

</odoo>
