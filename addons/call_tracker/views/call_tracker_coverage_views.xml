<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_call_tracker_coverage_list" model="ir.ui.view">
        <field name="name">call.tracker.coverage.list</field>
        <field name="model">call.tracker.coverage</field>
        <field name="arch" type="xml">
            <!-- Trié du plus délaissé au plus suivi : c'est la liste des
                 comptes à rappeler, pas un annuaire. -->
            <list string="Couverture" create="false" edit="false"
                  default_order="last_call_date asc">
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="last_call_date"/>
                <field name="days_since_last_call"
                       decoration-danger="days_since_last_call &gt; 90"
                       decoration-warning="days_since_last_call &gt; 30"/>
                <field name="call_count" sum="Total des appels"/>
                <field name="never_called" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_call_tracker_coverage_pivot" model="ir.ui.view">
        <field name="name">call.tracker.coverage.pivot</field>
        <field name="model">call.tracker.coverage</field>
        <field name="arch" type="xml">
            <!-- Comptes couverts / non couverts par commercial. Le décompte
                 est plus honnête qu'un pourcentage calculé : on voit le
                 dénominateur, donc on voit si le portefeuille est renseigné. -->
            <pivot string="Couverture" sample="1">
                <field name="user_id" type="row"/>
                <field name="never_called" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_call_tracker_coverage_search" model="ir.ui.view">
        <field name="name">call.tracker.coverage.search</field>
        <field name="model">call.tracker.coverage</field>
        <field name="arch" type="xml">
            <search string="Couverture">
                <field name="partner_id"/>
                <field name="user_id"/>
                <filter name="jamais" string="Jamais appelés"
                        domain="[('never_called','=',True)]"/>
                <filter name="plus_30" string="Sans appel depuis 30 jours"
                        domain="[('days_since_last_call','&gt;',30)]"/>
                <filter name="plus_90" string="Sans appel depuis 90 jours"
                        domain="[('days_since_last_call','&gt;',90)]"/>
                <separator/>
                <filter name="mon_portefeuille" string="Mon portefeuille"
                        domain="[('user_id','=',uid)]"/>
                <separator/>
                <filter name="par_commercial" string="Commercial"
                        context="{'group_by': 'user_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_call_tracker_coverage" model="ir.actions.act_window">
        <field name="name">Couverture du portefeuille</field>
        <field name="res_model">call.tracker.coverage</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="view_call_tracker_coverage_search"/>
        <field name="context">{'search_default_par_commercial': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun compte assigné</p>
            <p>
                Cet écran liste les comptes ayant un commercial assigné, et la
                date du dernier appel passé à l'un de leurs contacts.
            </p>
            <p>
                S'il est vide alors que des appels remontent, c'est que le
                champ <em>Commercial</em> n'est renseigné sur aucune fiche
                client : sans lui, il n'y a pas de portefeuille, donc pas de
                couverture à mesurer.
            </p>
        </field>
    </record>

</odoo>
