<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        `noupdate="1"` ASSUMÉ ici, contrairement aux groupes : une mise à jour
        du module ne doit pas réactiver une tâche qu'un administrateur aurait
        volontairement coupée, ni réécrire sa fréquence.
    -->
    <data noupdate="1">
        <record id="cron_echango_promo_purge_audit" model="ir.cron">
            <field name="name">echango Promo : purge du journal des lots</field>
            <field name="model_id" ref="model_echango_promo_audit"/>
            <field name="state">code</field>
            <field name="code">model._purger()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!--
            ⚠️ Le cron `cron_echango_promo_geocodage` a été RETIRÉ le
            2026-09-05 : le géocodage inverse ne se fait plus ici. echango
            Promo résout la position à la pose (via echango-geo) et transmet
            `ville`/`wilaya` dans l'instantané. Le fichier étant `noupdate="1"`,
            retirer le record de l'XML ne le supprime PAS en base — c'est
            `migrations/19.0.1.2.0/post-migration.py` qui le fait.
        -->
    </data>
</odoo>
