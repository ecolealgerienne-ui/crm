<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        `noupdate="1"` ASSUMÉ ici, contrairement aux groupes : une mise à jour
        du module ne doit pas réactiver une tâche qu'un administrateur aurait
        volontairement coupée, ni réécrire sa fréquence.
    -->
    <data noupdate="1">
        <record id="cron_echango_promo_purge_audit" model="ir.cron">
            <field name="name">echango Promo : purge du journal des lots</field>
            <field name="model_id" ref="model_echango_promo_audit"/>
            <field name="state">code</field>
            <field name="code">model._purger()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!--
            ⚠️ Toutes les 15 minutes et par lots de 25, PAS d'un coup : la
            politique d'usage de Nominatim impose une requête par seconde au
            plus, et la dépasser fait bannir l'adresse IP du serveur — ce qui
            se découvre bien après.
        -->
        <record id="cron_echango_promo_geocodage" model="ir.cron">
            <field name="name">echango Promo : géocodage inverse des positions</field>
            <field name="model_id" ref="model_echango_promo_account"/>
            <field name="state">code</field>
            <field name="code">model._cron_geocoder()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
