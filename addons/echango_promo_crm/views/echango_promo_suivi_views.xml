<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_echango_promo_suivi_list" model="ir.ui.view">
        <field name="name">echango.promo.suivi.list</field>
        <field name="model">echango.promo.suivi</field>
        <field name="arch" type="xml">
            <!--
                ⚠️ **Une case vide doit DIRE pourquoi elle est vide.** L'ordre
                place les commerçants qui n'ont jamais publié en tête — ce sont
                les plus coûteux, l'onboarding raté — et leurs quatre colonnes
                de publication sont donc vides par construction. Sans la colonne
                « Jamais publié » ni la mise en forme, l'écran se lit comme un
                tableau cassé alors qu'il dit exactement ce qu'il doit dire.
            -->
            <list string="Suivi des commerçants" create="false" edit="false"
                  decoration-muted="jamais_publie"
                  decoration-danger="not peut_publier">
                <!-- ⚠️ Une ligne de vue SQL n'a pas de formulaire utile : le
                     clic doit mener au CLIENT, là où vivent les appels, les
                     notes et les activités. D'où ce bouton en tête de ligne. -->
                <button name="action_ouvrir_client" type="object"
                        icon="fa-external-link" title="Ouvrir la fiche client"/>
                <field name="partner_id"/>
                <field name="city"/>
                <field name="wilaya" optional="hide"/>
                <!-- Une ville vide ne dit pas POURQUOI elle l'est : sans
                     position, pas encore géocodée, ou géocodée sans résultat —
                     trois gestes différents. -->
                <field name="geocodage_statut" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="jamais_publie" string="Jamais publié"
                       widget="boolean_favorite" optional="show"/>
                <field name="date_derniere_publication"/>
                <field name="jours_depuis_publication"/>
                <field name="promos_en_ligne"/>
                <field name="promos_visibles"/>
                <field name="peut_publier" widget="boolean_toggle" readonly="1"/>
                <field name="motif_blocage"/>
                <field name="signalements_90j"/>
                <!-- ⚠️ La fraîcheur est affichée à côté des chiffres : sans
                     elle, « n'a rien publié » et « le lot n'est pas arrivé »
                     se lisent pareil. -->
                <field name="derniere_synchro"/>
            </list>
        </field>
    </record>

    <record id="view_echango_promo_suivi_search" model="ir.ui.view">
        <field name="name">echango.promo.suivi.search</field>
        <field name="model">echango.promo.suivi</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="city"/>
                <field name="wilaya"/>
                <!--
                    ⚠️ **Les six états sont des FILTRES, pas une colonne.**
                    Les mettre dans la vue SQL aurait figé les seuils dans du
                    code à remonter ; ici, l'équipe peut aussi composer ses
                    propres filtres sans toucher au module.

                    L'ordre de lecture compte : « Bloqué » d'abord, parce qu'un
                    commerçant bloqué ne se relance pas, il se débloque.
                -->
                <filter name="bloque" string="Bloqué"
                        domain="[('peut_publier','=',False)]"/>
                <filter name="non_active" string="Jamais publié"
                        domain="[('jamais_publie','=',True)]"/>
                <filter name="actif" string="Actif"
                        domain="[('promos_en_ligne','&gt;',0)]"/>
                <separator/>
                <filter name="en_pause" string="En pause (&lt; 7 j)"
                        domain="[('jours_depuis_publication','&lt;',7)]"/>
                <filter name="a_risque" string="À risque (7–21 j)"
                        domain="[('jours_depuis_publication','&gt;=',7),
                                 ('jours_depuis_publication','&lt;',21)]"/>
                <filter name="dormant" string="Dormant (&gt; 21 j)"
                        domain="[('jours_depuis_publication','&gt;=',21)]"/>
                <separator/>
                <filter name="non_affecte" string="Sans commercial"
                        domain="[('user_id','=',False)]"/>
                <filter name="sans_ville" string="Sans ville"
                        domain="[('city','=',False)]"/>
                <!--
                    ⚠️ **Pas de `<group expand="0">` autour des regroupements.**
                    Odoo 19 a resserré la grammaire des vues de recherche :
                    `expand` n'est plus un attribut valide de `<group>`, et un
                    `<group>` y attend des `<field>`, pas des `<filter>`. Les
                    deux erreurs sont rendues par le validateur RelaxNG en
                    AVERTISSEMENT, et seule la ligne « Invalid view … » sort en
                    erreur — sans l'option de journal `odoo.tools.convert:DEBUG`, on
                    ne sait pas ce qui est invalide.
                -->
                <separator/>
                <filter name="par_ville" string="Ville" context="{'group_by':'city'}"/>
                <filter name="par_wilaya" string="Wilaya" context="{'group_by':'wilaya'}"/>
                <filter name="par_commercial" string="Commercial" context="{'group_by':'user_id'}"/>
                <filter name="par_motif" string="Motif de blocage" context="{'group_by':'motif_blocage'}"/>
            </search>
        </field>
    </record>


    <!--
        ⚠️ **Écran obligatoire, pas un confort.** La Couverture du portefeuille
        du Call Tracker filtre sur `user_id IS NOT NULL` : un commerçant
        fraîchement synchronisé, sans commercial, n'apparaît NULLE PART — ni
        dans les appels (jamais appelé), ni dans la couverture (pas de
        commercial). Il existe et personne ne le voit.
    -->

    <!--
        ⚠️ **Cet écran reste sur la vue SQL, et lui seul.** Les trois écrans de
        travail sont bâtis sur `res.partner` pour que le clic mène à la fiche
        client ; celui-ci sert à ANALYSER — croiser ville, motif et ancienneté —
        et il a besoin des jours écoulés recalculés à chaque lecture, ce qu'un
        champ stocké ne peut pas donner.
    -->
    <record id="action_echango_promo_analyse" model="ir.actions.act_window">
        <field name="name">Analyse du suivi</field>
        <field name="res_model">echango.promo.suivi</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{'create': False}</field>
    </record>
</odoo>
