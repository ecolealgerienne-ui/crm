<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_echango_promo_audit_list" model="ir.ui.view">
        <field name="name">echango.promo.audit.list</field>
        <field name="model">echango.promo.audit</field>
        <field name="arch" type="xml">
            <list string="Journal des lots" create="false" edit="false"
                  decoration-danger="not accepte">
                <field name="create_date" string="Reçu le"/>
                <field name="source_id"/>
                <field name="route"/>
                <field name="batch"/>
                <field name="accepte"/>
                <field name="fiches" sum="Fiches"/>
                <field name="refusees" sum="Refusées"/>
                <field name="detail"/>
                <field name="ip"/>
            </list>
        </field>
    </record>

    <record id="action_echango_promo_audit" model="ir.actions.act_window">
        <field name="name">Journal des lots</field>
        <field name="res_model">echango.promo.audit</field>
        <field name="view_mode">list</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun lot reçu.</p>
            <p>⚠️ Un journal vide ne dit pas que tout va bien : il dit que rien
               n'est arrivé. Regarder l'écran <b>Source et jeton</b> pour savoir
               depuis quand.</p>
        </field>
    </record>
</odoo>
